{
  "name": "earthlight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time 3D Earth and Sun visualization with day-night terminator, purely in the browser.",
  "scripts": {
    "test": "node --test src/*.test.js",
    "start": "npm run build && python3 -m http.server --bind 127.0.0.1 --directory _site 8000",
    "build": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "puppeteer-core": "24.30.0",
    "three": "0.180.0",
    "sharp": "0.34.4"
  }
}
